# Copy to backend.hcl and run: terraform init -backend-config=backend.hcl
# All stacks keep their state in the bucket of account A.
namespace           = "your-object-storage-namespace"
bucket              = "terraform-states"
key                 = "cluster/terraform.tfstate"
# the home region and the profile of account A
region              = "us-ashburn-1"
config_file_profile = "DEFAULT"
